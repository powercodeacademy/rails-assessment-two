<p id="sweet-info"><%= notice %></p>

<p>
  <h3>Name:</h3>
  <%= @sweet.name %>
  <h3>Where to buy:</h3>
  <ul>
  <% @sweet.vendors.each do |vendor| %>
    <li><%= link_to vendor.name, vendor %></li>
  <% end  %>
</ul>

<%= render 'form' %>

<h3>Reviews:</h3>
  <ul>
  <% @sweet.comments.select(&:persisted?).each do |comment| %>
    <li><%= comment.comment %></li>
  <% end %>
  </ul>
