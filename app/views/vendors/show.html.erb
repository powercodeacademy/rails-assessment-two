<h1><%= @vendor.name %></h1>

<p>Sweets Sold:</p>
<ul>
<% @vendor.sweets.each do |sweet| %>
  <li><%= link_to sweet.name, sweet_path(sweet) %></li>
<% end %>
</ul>

<h3>Add a Sweet to this Vendor</h3>
<% if @vendor_sweet && @vendor_sweet.errors.any? %> 
  <div class="error-messages">
    <h4>Please fix the following:</h4>
    <ul>
      <% @vendor_sweet.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: VendorSweet.new, url: vendor_sweets_path, local: true do |f| %>
  <%= f.hidden_field :vendor_id, value: @vendor.id %>

  <div>
    <%= f.label :sweet_id, "Select Sweet" %>
    <%= f.collection_select :sweet_id, Sweet.all, :id, :name, prompt: "Choose a sweet" %>
  </div>

  <div>
    <%= f.label :comment %>
    <%= f.text_field :comment %>
  </div>

  <%= f.submit "Add Sweet" %>
<% end %>
