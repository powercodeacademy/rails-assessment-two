<h1><%= @vendor.name %></h1>

<ul>
  <% @vendor.vendor_sweets.each do |vendor_sweet| %>
    <li>
      <%= vendor_sweet.sweet.name %> 
      <%= vendor_sweet.comment %>
    </li>
  <% end %>
</ul>

<h2>Add a Sweet</h2>

<%= form_with model: @vendor_sweet, local: true do |f| %>

  <%= f.hidden_field :vendor_id, value: @vendor.id %>

  <%= f.label :sweet_id, "Sweet" %>
  <%= f.collection_select :sweet_id, @sweets, :id, :name, prompt: "Select a sweet" %>

  <%= f.label :comment %>
  <%= f.text_field :comment %>

  <%= f.submit %>

<% end %>