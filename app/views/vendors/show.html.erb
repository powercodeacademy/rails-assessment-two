<h1><%= @vendor.name %></h1>

<ul>
  <% @vendor.vendor_sweets.each do |vendor_sweet| %>
    <li>
      <%= link_to vendor_sweet.sweet.name, vendor_sweet.sweet %>
      <%= vendor_sweet.comment %>
    </li>
  <% end %>
</ul>

<br />

<h2>New Sweet</h2>
<%= form_with model: @vendor_sweet, local: true do |f|%>
<%= f.hidden_field :vendor_id, value: @vendor.id %>

  <%= f.label :sweet_id %>
  <%= f.collection_select :sweet_id, Sweet.all, :id, :name %>
  <br />
  <br />

  <%= f.label :comment %>
  <%= f.text_field :comment %>
  <br />
  <br />

  <%= f.submit %>
<% end %>
