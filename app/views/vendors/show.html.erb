<h1>Sweets in Vendor </h1>
<div>

<% if @vendor_sweet.errors.any? %>
<% @vendor_sweet.errors.full_messages.each do |msg| %>
  <p><%= msg  %></p>
 <% end %>
<% end %>

   <% @vendor.vendor_sweets.each do |vendor_sweet| %>
    <li><%= "#{vendor_sweet.sweet.name} #{vendor_sweet.comment} "%> </li> 
 <% end %>
</div>

 <%= form_for @vendor_sweet do |f| %>
  <%= f.hidden_field :vendor_id, value: @vendor.id %>
  <%= f.collection_select :sweet_id, @sweets, :id, :name %>
  <%= f.text_field :comment %>
<%= f.submit "Submit" %>
<% end %>
