<h1><%= @vendor.name %></h1>
<h3>Available Sweets: </h3>
<ul>
  <% @vendor_sweets.each do |vendor_sweet| %>
    <li>
      <%= link_to vendor_sweet.sweet.name, sweet_path(vendor_sweet.sweet) %><br>
      <span style="font-style: italic;"><%= vendor_sweet.comment %></span>
    </li>
  <% end %>
</ul>
<h3>Add a new item: </h3>
<%= form_with model: @vendor_sweet, local: true do |f| %>
  <%= f.label :sweet_id, 'Sweet: ' %>
  <%= f.collection_select :sweet_id, Sweet.where.not(id: @vendor.sweets.select(:id)), :id, :name, { required: true } %><br>

  <%= f.label :comment, 'Comment: ' %>
  <%= f.text_field :comment, { required: true } %><br>

  <%= f.hidden_field :vendor_id, value: @vendor.id %>
  <%= f.submit 'Add Sweet' %>
<% end %>