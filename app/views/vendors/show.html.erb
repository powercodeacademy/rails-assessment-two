<h1><%= @vendor.name %></h1>

<ul>
  <% @vendor.vendor_sweets.each do |vendor_sweet| %>
    <li><%= link_to vendor_sweet.sweet.name, vendor_sweet.sweet %> - <%= vendor_sweet.comment %></li>
  <% end %>
</ul>

<h3>Add a sweet</h3>
<%= form_for @vendor_sweet, url: vendor_vendor_sweets_path(@vendor) do |f| %>
  <% if @vendor_sweet.errors.any? %>
    <ul>
      <% @vendor_sweet.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <%= f.label :sweet_id, "Sweet" %>
  <%= f.collection_select :sweet_id, Sweet.all, :id, :name, include_blank: true %>

  <%= f.label :comment %>
  <%= f.text_field :comment %>

  <%= f.submit "Add Sweet" %>
<% end %>